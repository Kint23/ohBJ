# ---- 敏感凭据：绝不提交 ----
.env
*.env
.env.*

# ---- 本地/工具产物 ----
data/cache/
__pycache__/
*.pyc
.venv/
venv/

# 部署用的裁剪产物（由 stage 命令生成，不进仓库）
dist/

# ---- 编辑器/系统 ----
.vscode/*
!.vscode/settings.json
Thumbs.db
desktop.ini

# ---- 可由 tools/ 重新生成的大图（seed 固定，见 docs/AI素材说明.md）----
banner/ai-bg-*.png
banner/film-*.png
banner/demo/
banner/_*.png

# 「开场」是 片头+氛围 的拼接产物，可随时用 --concat-only 重建，不入仓库
video/开场-*.mp4

# 正片的中间产物（可由 tools/ 重建）
video/_raw.webm
video/_frames/
video/_timeline.json
video/music.wav
video/subs.ass
video/subs.srt
# 字幕只保留内嵌那一份；外挂 SRT 可按需用 record_demo.py --srt-only 重新导出
video/正片字幕.srt
